{
	"name": "fabrial",
	"version": "0.0.0",
	"description": "Durable workflows, AI agents, and human approvals in TypeScript.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/psteinroe/fabrial.git",
		"directory": "packages/fabrial"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./testing": "./src/testing.ts"
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./testing": {
				"types": "./dist/testing.d.ts",
				"default": "./dist/testing.js"
			}
		},
		"access": "public"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@standard-schema/spec": "catalog:"
	},
	"devDependencies": {
		"zod": "catalog:"
	}
}
