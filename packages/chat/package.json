{
	"name": "@fabrial/chat",
	"version": "0.0.0",
	"description": "Chat SDK integration for Fabrial.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/psteinroe/fabrial.git",
		"directory": "packages/chat"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"access": "public"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@chat-adapter/state-pg": "catalog:",
		"chat": "catalog:",
		"fabrial": "workspace:*"
	}
}
